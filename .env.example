# Development values only. Replace all placeholders with private values.
POSTGRES_DB=usuariosdb
POSTGRES_USER=usuarios
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
MONGO_USERNAME=root
MONGO_PASSWORD=replace-with-a-local-mongo-password

# Shared HS256 key, at least 32 bytes.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Gateway injects X-Gateway-Secret; casos-service validates it.
GATEWAY_SECRET=replace-with-a-private-gateway-secret
# users_service validates X-Internal-Token for service role access.
INTERNAL_API_TOKEN=replace-with-a-private-internal-service-token
SERVICE_HTTP_TIMEOUT_SECONDS=5
ADMIN_PASSWORD=replace-with-a-local-admin-password

# Docker Compose internal service URLs and ports.
EUREKA_SERVER_URL=http://eureka-server:8762/eureka/
PARTIDAS_PORT=8000

# Short discovery/cache periods for local development only; use Spring defaults in production.
EUREKA_REGISTRY_FETCH_INTERVAL_SECONDS=2
EUREKA_LEASE_RENEWAL_INTERVAL_SECONDS=5
LOADBALANCER_CACHE_TTL=2s
