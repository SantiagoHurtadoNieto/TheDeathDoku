# Development values only. Replace all placeholders with private values.
POSTGRES_DB=usuariosdb
POSTGRES_USER=usuarios
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
MONGO_USERNAME=root
MONGO_PASSWORD=replace-with-a-local-mongo-password

# Gateway injects X-Gateway-Secret; trusted services validate it.
GATEWAY_SECRET=replace-with-a-private-gateway-secret
# users_service validates X-Internal-Token for service role access.
INTERNAL_API_TOKEN=replace-with-a-private-internal-service-token
SERVICE_HTTP_TIMEOUT_SECONDS=5

# Docker Compose internal service URLs and ports.
EUREKA_SERVER_URL=http://eureka-server:8762/eureka/
PARTIDAS_PORT=8000

# Short discovery/cache periods for local development only; use Spring defaults in production.
EUREKA_REGISTRY_FETCH_INTERVAL_SECONDS=2
EUREKA_LEASE_RENEWAL_INTERVAL_SECONDS=5
LOADBALANCER_CACHE_TTL=2s

# Kafka local PoC. Consumer groups are configured per service.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_POC_PING_ON_START=false

# Keycloak PoC only (Keycloak 26.8.2, start-dev, local development)
KC_HOSTNAME=http://localhost:8180
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-local-keycloak-admin-password
KC_JUGADOR1_PASSWORD=replace-with-a-local-jugador1-password
KC_ADMIN1_PASSWORD=replace-with-a-local-admin1-password

# Dev-only users created by infra/keycloak/dev-setup.ps1 for the Bruno regression.
# Never reuse these values outside local development.
KC_TEST_A_PASSWORD=replace-with-a-local-test-a-password
KC_TEST_B_PASSWORD=replace-with-a-local-test-b-password
KC_TEST_ADMIN_PASSWORD=replace-with-a-local-test-admin-password

# Keycloak JWT validation in api-gateway.
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/hopedoku
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/hopedoku/protocol/openid-connect/certs
KEYCLOAK_AUTHORIZED_PARTY=hopedoku-godot
# Dev-only alternative (comma-separated) used by docker-compose.dev.yml:
# KEYCLOAK_ALLOWED_AZP=hopedoku-godot
