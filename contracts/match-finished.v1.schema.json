{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deathdoku.local/contracts/match-finished.v1.schema.json",
  "title": "MatchFinished v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "correlationId", "occurredAt", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matchId", "caseId", "mode", "timeSeconds", "results"],
      "properties": {
        "matchId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "caseId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "mode": { "enum": ["CLASSIC", "TIMED", "VERSUS"] },
        "timeSeconds": { "type": "integer", "minimum": 0 },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["userId", "won", "xpDelta", "difficulty"],
            "properties": {
              "userId": { "type": "string", "minLength": 1, "maxLength": 255 },
              "won": { "type": "boolean" },
              "xpDelta": { "type": ["integer", "null"] },
              "difficulty": { "type": ["string", "null"], "enum": ["EASY", "MEDIUM", "HARD", null] }
            }
          }
        }
      }
    }
  }
}
