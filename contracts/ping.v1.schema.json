{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ping event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "correlationId", "occurredAt", "payload"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "message": {
          "type": "string"
        }
      }
    }
  }
}
