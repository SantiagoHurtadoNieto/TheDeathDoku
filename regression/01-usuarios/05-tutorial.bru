meta {
  name: Mark tutorial complete
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/usuarios/users/me/tutorial
  body: json
}

headers {
  Authorization: Bearer {{tokenA}}
}

body:json {
  {
    "completed": true
  }
}

tests {
  test("tutorial update returns the user", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("tutorialCompleted");
  });
}
