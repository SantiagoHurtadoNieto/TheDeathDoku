meta {
  name: Second profile read returns the same user
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/usuarios/users/me
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

tests {
  test('second read returns the same userId', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property('userId', bru.getVar('userAId'));
  });
}
