meta {
  name: Get profile creates it
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/usuarios/users/me
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

tests {
  test('profile exists with the expected shape', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property('userId').that.is.a('string');
    expect(res.getBody()).to.have.property('roles').that.is.an('array');
  });
}
