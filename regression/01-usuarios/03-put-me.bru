meta {
  name: Update profile
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/usuarios/users/me
  body: json
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

body:json {
  {
    "name": "Regression User",
    "avatar": "https://example.test/avatar.png"
  }
}

tests {
  test('profile update returns name and avatar', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property('name', 'Regression User');
    expect(res.getBody()).to.have.property('avatar', 'https://example.test/avatar.png');
  });
}
