meta {
  name: List achievements
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/usuarios/users/me/achievements
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

tests {
  test('achievements are returned as an array', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an('array');
  });
}
