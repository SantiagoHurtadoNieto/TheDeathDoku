meta {
  name: Stats before matches
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/usuarios/users/me/stats
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

tests {
  test('stats expose numeric counters', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property('solvedCases').that.is.a('number');
    expect(res.getBody()).to.have.property('experience').that.is.a('number');
    bru.setVar('statsBefore', res.getBody());
  });
}
