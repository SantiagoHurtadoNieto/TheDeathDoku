meta {
  name: Reject invalid language
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/usuarios/users/me/language
  body: json
}

headers {
  Authorization: Bearer {{tokenA}}
}

body:json {
  {
    "language": "fr"
  }
}

tests {
  test("invalid language returns 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
}
