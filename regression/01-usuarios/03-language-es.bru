meta {
  name: Set language
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/usuarios/users/me/language
  body: json
}

headers {
  Authorization: Bearer {{tokenA}}
}

body:json {
  {
    "language": "es"
  }
}

tests {
  test("valid language update returns 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("language");
  });
}
