meta {
  name: Update profile
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/usuarios/users/me
  body: json
}

headers {
  Authorization: Bearer {{tokenA}}
}

body:json {
  {
    "name": "Regression User",
    "avatar": "https://example.test/avatar.png"
  }
}

tests {
  test("profile update returns its JSON shape", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("name");
    expect(res.getBody()).to.have.property("avatar");
  });
}
