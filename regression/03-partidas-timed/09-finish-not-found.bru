meta {
  name: Finish an unknown match
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/partidas/matches/timed/000000000000000000000000/finish
  body: json
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

body:json {
  {
    "positions": [
      { "characterId": "V1", "x": 0, "y": 0 },
      { "characterId": "S1", "x": 1, "y": 0 },
      { "characterId": "S2", "x": 0, "y": 1 },
      { "characterId": "S3", "x": 2, "y": 1 }
    ]
  }
}

tests {
  test('unknown match returns 404', function() {
    expect(res.getStatus()).to.equal(404);
  });
}
