meta {
  name: Lose the 60-second match
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/partidas/matches/timed/{{timedLossId}}/finish
  body: json
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

body:json {
  {
    "positions": [
      { "characterId": "V1", "x": 0, "y": 0 },
      { "characterId": "S1", "x": 2, "y": 0 },
      { "characterId": "S2", "x": 0, "y": 1 },
      { "characterId": "S3", "x": 2, "y": 1 }
    ]
  }
}

tests {
  test('incorrect solution is a loss with -10 XP', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property('won', false);
    expect(res.getBody()).to.have.property('bonus', 0);
    expect(res.getBody()).to.have.property('xpDelta', -10);
  });
}
