meta {
  name: Create timed match for the bonus observation
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/partidas/matches/timed
  body: json
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

body:json {
  {
    "caseId": "{{caseId}}",
    "timeLimitSeconds": 3600
  }
}

tests {
  test('maximum valid time limit is accepted', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property('matchId').that.is.a('string');
    bru.setVar('timedWinId', res.getBody().matchId);
  });
}
