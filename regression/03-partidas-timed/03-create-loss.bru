meta {
  name: Create timed match for a loss
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/partidas/matches/timed
  body: json
}

headers {
  Authorization: Bearer {{tokenA}}
}

body:json {
  {
    "caseId": "{{caseId}}",
    "timeLimitSeconds": 600
  }
}

tests {
  test("second timed match is created", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("matchId");
    bru.setVar("timedLossId", res.getBody().matchId);
  });
}
