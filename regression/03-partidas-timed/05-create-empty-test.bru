meta {
  name: Create timed match for empty positions validation
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/partidas/matches/timed
  body: json
}

headers {
  Authorization: Bearer {{tokenA}}
}

body:json {
  {
    "caseId": "{{caseId}}",
    "timeLimitSeconds": 600
  }
}

tests {
  test("validation test match is created", function() {
    expect(res.getStatus()).to.equal(200);
    bru.setVar("timedEmptyId", res.getBody().matchId);
  });
}
