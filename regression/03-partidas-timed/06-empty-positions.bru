meta {
  name: Reject empty positions
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/partidas/matches/timed/{{timedEmptyId}}/finish
  body: json
}

headers {
  Authorization: Bearer {{tokenA}}
}

body:json {
  {
    "positions": []
  }
}

tests {
  test("empty positions is rejected by request validation", function() {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody()).to.be.an("object");
  });
}
