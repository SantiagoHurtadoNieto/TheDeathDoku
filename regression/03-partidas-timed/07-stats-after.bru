meta {
  name: Compare stats after timed matches
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/usuarios/users/me/stats
}

headers {
  Authorization: Bearer {{tokenA}}
}

tests {
  test("winning a timed match updates solved cases and XP", function() {
    expect(res.getStatus()).to.equal(200);
    const before = bru.getVar("statsBeforeGames");
    const after = res.getBody();
    expect(after.solvedCases).to.be.greaterThan(before.solvedCases);
    expect(after.experience).to.not.equal(before.experience);
  });
}
