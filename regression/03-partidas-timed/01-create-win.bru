meta {
  name: Create timed match for a win
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/partidas/matches/timed
  body: json
}

headers {
  Authorization: Bearer {{tokenA}}
}

body:json {
  {
    "caseId": "{{caseId}}",
    "timeLimitSeconds": 600
  }
}

tests {
  test("timed match is created with an id", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("matchId").that.is.a("string");
    bru.setVar("timedWinId", res.getBody().matchId);
  });
}
