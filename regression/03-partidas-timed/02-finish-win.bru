meta {
  name: Finish timed match with correct positions
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/partidas/matches/timed/{{timedWinId}}/finish
  body: json
}

headers {
  Authorization: Bearer {{tokenA}}
}

body:json {
  {
    "positions": [
      { "characterId": "V1", "x": 0, "y": 0 },
      { "characterId": "S1", "x": 1, "y": 0 },
      { "characterId": "S2", "x": 0, "y": 1 },
      { "characterId": "S3", "x": 2, "y": 1 }
    ]
  }
}

tests {
  test("correct solution wins and awards positive bonus and XP", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("won", true);
    expect(res.getBody().bonus).to.be.a("number").and.greaterThan(0);
    expect(res.getBody().xpDelta).to.be.a("number").and.greaterThan(0);
  });
}
