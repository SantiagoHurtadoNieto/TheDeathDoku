meta {
  name: User A creates versus match
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/partidas/matches/versus
  body: json
}

headers {
  Authorization: Bearer {{tokenA}}
}

body:json {
  {
    "caseId": "{{caseId}}"
  }
}

tests {
  test("versus match is created", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("matchId");
    bru.setVar("versusId", res.getBody().matchId);
  });
}
