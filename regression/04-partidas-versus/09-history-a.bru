meta {
  name: Get user A match history
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/partidas/matches/history/me
}

headers {
  Authorization: Bearer {{tokenA}}
}

tests {
  test("user A history contains the versus win", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
    expect(res.getBody().some((item) => item.matchId === bru.getVar("versusId") && item.result === "WON")).to.equal(true);
  });
}
