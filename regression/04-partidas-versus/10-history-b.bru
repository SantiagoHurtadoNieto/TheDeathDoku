meta {
  name: Get user B match history
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/partidas/matches/history/me
}

headers {
  Authorization: Bearer {{tokenB}}
}

tests {
  test("user B history contains the versus loss", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
    expect(res.getBody().some((item) => item.matchId === bru.getVar("versusId") && item.result === "LOST")).to.equal(true);
  });
}
