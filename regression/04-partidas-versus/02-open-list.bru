meta {
  name: Find versus match in open list
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/partidas/matches/versus/open
}

headers {
  Authorization: Bearer {{tokenA}}
}

tests {
  test("new versus match appears in open matches", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
    expect(res.getBody().some((item) => item.matchId === bru.getVar("versusId"))).to.equal(true);
  });
}
