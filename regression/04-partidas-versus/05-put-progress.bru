meta {
  name: User A reports progress
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/partidas/matches/versus/{{versusId}}/progress
  body: json
}

headers {
  Authorization: Bearer {{tokenA}}
}

body:json {
  {
    "progress": 0.5
  }
}

tests {
  test("progress update returns ok", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("ok", true);
  });
}
