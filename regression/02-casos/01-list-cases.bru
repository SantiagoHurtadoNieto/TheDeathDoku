meta {
  name: List cases and pick the seeded one
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/casos/cases
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

tests {
  test('case list contains the seeded case', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an('array');
    const item = res.getBody().find((entry) => entry.title === 'Muerte en la cocina');
    expect(item).to.exist;
    bru.setVar('caseId', item.id);
  });
}
