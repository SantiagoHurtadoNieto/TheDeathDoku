meta {
  name: Public validation is blocked with a valid bearer
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/casos/cases/{{caseId}}/validate
  body: json
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

body:json {
  {
    "positions": [
      { "characterId": "V1", "x": 0, "y": 0 },
      { "characterId": "S1", "x": 2, "y": 0 },
      { "characterId": "S2", "x": 0, "y": 1 },
      { "characterId": "S3", "x": 2, "y": 1 }
    ]
  }
}

tests {
  test('direct validation is forbidden even with a bearer token', function() {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody()).to.have.property('error', 'forbidden');
  });
}
