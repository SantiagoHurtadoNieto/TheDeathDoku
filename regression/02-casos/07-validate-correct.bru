meta {
  name: Validate correct positions
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/casos/cases/{{caseId}}/validate
  body: json
}

headers {
  Authorization: Bearer {{tokenA}}
}

body:json {
  {
    "positions": [
      { "characterId": "V1", "x": 0, "y": 0 },
      { "characterId": "S1", "x": 1, "y": 0 },
      { "characterId": "S2", "x": 0, "y": 1 },
      { "characterId": "S3", "x": 2, "y": 1 }
    ]
  }
}

tests {
  test("correct positions return valid true", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("valid", true);
  });
}
