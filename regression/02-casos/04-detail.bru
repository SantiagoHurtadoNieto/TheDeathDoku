meta {
  name: Get case detail
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/casos/cases/{{caseId}}
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

tests {
  test('case detail matches the selected case', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property('id', bru.getVar('caseId'));
  });
}
