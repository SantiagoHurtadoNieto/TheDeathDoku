meta {
  name: Filter cases by category
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/casos/cases?category=HOGAR
}

headers {
  Authorization: Bearer {{tokenA}}
}

tests {
  test("category filter returns only matching cases", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
    expect(res.getBody().length).to.be.greaterThan(0);
    res.getBody().forEach((item) => expect(item.category).to.equal("HOGAR"));
  });
}
