meta {
  name: Get first hint
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/casos/cases/{{caseId}}/hints?level=1
}

headers {
  Authorization: Bearer {{accessTokenA}}
}

tests {
  test('first hint has level and text', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property('level', 1);
    expect(res.getBody()).to.have.property('text').that.is.a('string');
  });
}
