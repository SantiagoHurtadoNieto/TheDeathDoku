meta {
  name: OBSERVACIÓN - Create timed match with a large limit
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/partidas/matches/timed
  body: json
}

headers {
  Authorization: Bearer {{tokenA}}
}

body:json {
  {
    "caseId": "{{caseId}}",
    "timeLimitSeconds": 1000000000
  }
}

tests {
  test("observation match is created", function() {
    expect(res.getStatus()).to.equal(200);
    bru.setVar("observationMatchId", res.getBody().matchId);
  });
}
