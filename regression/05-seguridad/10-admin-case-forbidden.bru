meta {
  name: Normal user cannot create an admin case
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/casos/admin/cases
  body: json
}

headers {
  Authorization: Bearer {{tokenA}}
  X-User-Id: 999
  X-Roles: ADMIN
}

body:json {
  {}
}

tests {
  test("normal user spoofing ADMIN receives 403", function() {
    expect(res.getStatus()).to.equal(403);
  });
}
