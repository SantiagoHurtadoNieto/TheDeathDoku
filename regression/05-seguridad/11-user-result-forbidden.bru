meta {
  name: Normal user cannot register a result directly
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/usuarios/users/{{userAId}}/results
  body: json
}

headers {
  Authorization: Bearer {{tokenA}}
}

body:json {
  {
    "caseId": "{{caseId}}",
    "mode": "TIMED",
    "won": true,
    "timeSeconds": 1,
    "xpDelta": 1
  }
}

tests {
  test("direct result registration is forbidden", function() {
    expect(res.getStatus()).to.equal(403);
  });
}
