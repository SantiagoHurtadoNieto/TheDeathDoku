meta {
  name: Gateway overwrites spoofed identity and roles
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/usuarios/users/me
}

headers {
  Authorization: Bearer {{tokenA}}
  X-User-Id: 999
  X-Roles: ADMIN
}

tests {
  test("manual identity headers do not change authenticated user", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getVar("userAId"));
  });
}
