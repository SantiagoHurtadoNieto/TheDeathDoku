meta {
  name: OBSERVACIÓN - Finish timed match and report bonus
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/partidas/matches/timed/{{observationMatchId}}/finish
  body: json
}

headers {
  Authorization: Bearer {{tokenA}}
}

body:json {
  {
    "positions": [
      { "characterId": "V1", "x": 0, "y": 0 },
      { "characterId": "S1", "x": 1, "y": 0 },
      { "characterId": "S2", "x": 0, "y": 1 },
      { "characterId": "S3", "x": 2, "y": 1 }
    ]
  }
}

script:post-response {
  const result = res.getBody();
  bru.setVar("observationBonus", result.bonus);
  console.log("BONO_OBSERVACION=" + result.bonus);
}

tests {
  test("observation reports a numeric bonus without a fixed threshold", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("bonus").that.is.a("number");
  });
}
