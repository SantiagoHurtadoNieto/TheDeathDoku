meta {
  name: Register invalid user
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/usuarios/auth/register
  body: json
}

body:json {
  {
    "username": "x",
    "email": "invalid-email",
    "password": "x"
  }
}

tests {
  test("invalid registration returns 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.be.an("object");
  });
}
