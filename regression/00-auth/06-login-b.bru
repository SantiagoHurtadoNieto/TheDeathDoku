meta {
  name: Login user B
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/usuarios/auth/login
  body: json
}

body:json {
  {
    "email": "{{emailB}}",
    "password": "{{passwordB}}"
  }
}

tests {
  test("login B returns a bearer token", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("accessToken").that.is.a("string");
    bru.setVar("tokenB", res.getBody().accessToken);
  });
}
