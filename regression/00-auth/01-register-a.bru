meta {
  name: Register user A
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/usuarios/auth/register
  body: json
}

script:pre-request {
  const suffix = Date.now().toString() + Math.random().toString(36).slice(2, 8);
  bru.setVar("runSuffix", suffix);
  bru.setVar("passwordA", "Bru" + suffix + "!Aa1");
  bru.setVar("usernameA", "bru_a_" + suffix);
  bru.setVar("emailA", "bru_a_" + suffix + "@example.test");
}

body:json {
  {
    "username": "{{usernameA}}",
    "email": "{{emailA}}",
    "password": "{{passwordA}}",
    "avatar": ""
  }
}

tests {
  test("register A returns 201 and a user id", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody()).to.have.property("id");
    bru.setVar("userAId", res.getBody().id);
  });
}
