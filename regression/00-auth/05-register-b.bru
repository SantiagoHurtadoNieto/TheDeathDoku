meta {
  name: Register user B
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/usuarios/auth/register
  body: json
}

script:pre-request {
  const suffix = bru.getVar("runSuffix");
  bru.setVar("passwordB", "BruB" + suffix + "!Aa1");
  bru.setVar("usernameB", "bru_b_" + suffix);
  bru.setVar("emailB", "bru_b_" + suffix + "@example.test");
}

body:json {
  {
    "username": "{{usernameB}}",
    "email": "{{emailB}}",
    "password": "{{passwordB}}",
    "avatar": ""
  }
}

tests {
  test("register B returns 201 and a user id", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody()).to.have.property("id");
    bru.setVar("userBId", res.getBody().id);
  });
}
