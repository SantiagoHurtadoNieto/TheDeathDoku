meta {
  name: Login with incorrect password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/usuarios/auth/login
  body: json
}

body:json {
  {
    "email": "{{emailA}}",
    "password": "wrong-password"
  }
}

tests {
  test("incorrect credentials return 401", function() {
    expect(res.getStatus()).to.equal(401);
  });
}
